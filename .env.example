# ============================================================
# College Exam Seating Management System - environment variables
# Copy to .env and adjust values. NEVER commit .env.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Database (PostgreSQL 16) ---
# Used by Prisma and by the direct pg pool (health check).
DATABASE_URL=postgresql://seating:seating_dev_password@localhost:5432/exam_seating?schema=public
# Host/port/user/password/db split out for docker-compose wiring
POSTGRES_USER=seating
POSTGRES_PASSWORD=seating_dev_password
POSTGRES_DB=exam_seating
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Auth (used from Phase 3) ---
# Generate strong secrets, e.g.: openssl rand -hex 64
JWT_SECRET=change_me_generate_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_generate_openssl_rand_hex_64
# Access token time-to-live (seconds). Default: 15 minutes
ACCESS_TOKEN_TTL=900
# Refresh token time-to-live (seconds). Default: 7 days
REFRESH_TOKEN_TTL=604800
REFRESH_COOKIE_NAME=rt
# bcrypt cost (>= 12)
PASSWORD_HASH_COST=12
# Bootstrap Super Admin (created on first seed/migrate; dev only)
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=ChangeMe_DevOnly_123!
SUPER_ADMIN_NAME=System Administrator

# --- CORS / frontend ---
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

# --- Seating engine (from Phase 6/7) ---
# Hard time budget for one generation run in the worker thread (ms)
SEATING_TIME_BUDGET_MS=10000
# Default number of previous papers considered
SEATING_DEFAULT_HISTORY_DEPTH=3

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
